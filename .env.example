# Copy to apps/web/.env.local and apps/admin/.env.local as needed.
# Every value below is optional for local demo use; sensible fallbacks exist.

# Public URLs (used for canonical URLs, sitemap, cross-app links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001

# WhatsApp contact button (digits only, with country code). Placeholder number.
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000

# Signs the demo session cookie. Use a long random string outside local dev.
# Both apps must share the same value.
AUTH_SECRET=change-me-to-a-long-random-string

# Shared token the admin app uses to read the storefront's live demo-order feed.
DEMO_FEED_TOKEN=change-me-too
# Where the admin server can reach the storefront (server-to-server).
WEB_INTERNAL_URL=http://localhost:3000

# Data adapter: "local" (browser localStorage, default) or "supabase".
NEXT_PUBLIC_DATA_ADAPTER=local

# Only needed when NEXT_PUBLIC_DATA_ADAPTER=supabase. Server-only: never expose to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
